{
  "name": "canada",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "カナダワーホリ（2027-04-01 入国）の準備と到着後の手続きを管理する PWA（Cloudflare Workers + D1）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "local": "node scripts/build.mjs && node scripts/local-server.mjs",
    "test": "node scripts/build.mjs && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply canada --local",
    "db:migrate:remote": "wrangler d1 migrations apply canada --remote",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": ">=0.25.0",
    "sharp": ">=0.34.0",
    "typescript": ">=5.6.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
